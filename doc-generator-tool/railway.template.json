{
  "$schema": "https://railway.app/railway.schema.json",
  "template": {
    "name": "Claude Code Doc Generator",
    "description": "智能文档生成器 - 基于Claude Code SDK的项目分析和文档生成工具",
    "source": {
      "repo": "mychenxh/cc-sdk-demo",
      "ref": "doc-generator-20250815"
    },
    "rootDirectory": "demo-doc-generator"
  },
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install"
  },
  "deploy": {
    "startCommand": "python3 -m http.server $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/index.html",
    "healthcheckTimeout": 60,
    "healthcheckInterval": 30
  },
  "environments": {
    "production": {
      "variables": {
        "NODE_ENV": "production",
        "PORT": "$PORT"
      }
    }
  }
}