{
  "version": "1.0",
  "name": "document-generator-mcp",
  "description": "AI驱动的项目文档生成器MCP服务",
  "mcpServers": {
    "document-generator": {
      "command": "node",
      "args": [
        "/Users/lshl124/Documents/daniel/git/code/aigc/cc-sdk-demo/doc-generator-tool/dist/src/mcp-server.js"
      ],
      "env": {
        "NODE_ENV": "production"
      }
    }
  },
  "tools": {
